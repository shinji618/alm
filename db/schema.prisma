/// 사용자 역할 — 역할 부여와 범위(회사코드·사이트). 범위가 비면 전체
model UserRole {
  id String @id @default(uuid(7)) @db.Uuid
  /// 테넌트
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation("user_role_tenant_id", fields: [tenantId], references: [id])
  /// 사용자
  userId String @map("user_id") @db.Uuid
  user AppUser @relation("user_role_user_id", fields: [userId], references: [id])
  /// 역할
  role RoleCode
  /// 회사코드 범위
  companyId String? @map("company_id") @db.Uuid
  company Company? @relation("user_role_company_id", fields: [companyId], references: [id])
  /// 사이트 범위
  siteId String? @map("site_id") @db.Uuid
  site Site? @relation("user_role_site_id", fields: [siteId], references: [id])
  /// 코스트센터 범위(DEPT_MANAGER)
  costCenterId String? @map("cost_center_id") @db.Uuid
  costCenter CostCenter? @relation("user_role_cost_center_id", fields: [costCenterId], references: [id])
  /// 유효 시작일(비면 즉시)
  validFrom DateTime? @map("valid_from") @db.Date
  /// 유효 종료일(임시 실사 담당·감사인). 지나면 권한 없음
  validUntil DateTime? @map("valid_until") @db.Date
  /// 생성 일시
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
