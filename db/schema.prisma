  /// 첫 로그인 때 사용자 자동 생성(역할 EMPLOYEE만)
  jitProvision Boolean @default(false) @map("jit_provision")
  /// 화면 표시 시간대
  timeZone String @default("America/New_York") @map("time_zone") @db.VarChar(40)
  /// 사용 여부
  isActive Boolean @default(true) @map("is_active")
  /// 생성 일시
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 생성자
  createdBy String? @map("created_by") @db.Uuid
  /// 변경 일시
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 변경자
  updatedBy String? @map("updated_by") @db.Uuid
  /// 낙관적 잠금
  version Int @default(1)
  tenantDomains TenantDomain[] @relation("tenant_domain_tenant_id")
  appUsers AppUser[] @relation("app_user_tenant_id")
  userRoles UserRole[] @relation("user_role_tenant_id")
  companies Company[] @relation("company_tenant_id")
  plants Plant[] @relation("plant_tenant_id")
  profitCenters ProfitCenter[] @relation("profit_center_tenant_id")
  costCenters CostCenter[] @relation("cost_center_tenant_id")
  assetClasses AssetClass[] @relation("asset_class_tenant_id")
  sites Site[] @relation("site_tenant_id")
  rooms Room[] @relation("room_tenant_id")
  categories Category[] @relation("category_tenant_id")
  models Model[] @relation("model_tenant_id")
  vendors Vendor[] @relation("vendor_tenant_id")
  assets Asset[] @relation("asset_tenant_id")
  assetValues AssetValue[] @relation("asset_value_tenant_id")
  assetAssignments AssetAssignment[] @relation("asset_assignment_tenant_id")
  assetEvents AssetEvent[] @relation("asset_event_tenant_id")
  discoveryJobs DiscoveryJob[] @relation("discovery_job_tenant_id")
  discoveryRuns DiscoveryRun[] @relation("discovery_run_tenant_id")
  discoveryItems DiscoveryItem[] @relation("discovery_item_tenant_id")
  configItems ConfigItem[] @relation("config_item_tenant_id")
  ciRelations CiRelation[] @relation("ci_relation_tenant_id")
  ticketLinks TicketLink[] @relation("ticket_link_tenant_id")
  softwareProducts SoftwareProduct[] @relation("software_product_tenant_id")
  licenses License[] @relation("license_tenant_id")
  licenseAssignments LicenseAssignment[] @relation("license_assignment_tenant_id")
  softwareInstalls SoftwareInstall[] @relation("software_install_tenant_id")
  contracts Contract[] @relation("contract_tenant_id")
  contractAssets ContractAsset[] @relation("contract_asset_tenant_id")
  purchaseRequests PurchaseRequest[] @relation("purchase_request_tenant_id")
  purchaseRequestItems PurchaseRequestItem[] @relation("purchase_request_item_tenant_id")
  poItems PoItem[] @relation("po_item_tenant_id")
  poItemAssets PoItemAsset[] @relation("po_item_asset_tenant_id")
  goodsReceipts GoodsReceipt[] @relation("goods_receipt_tenant_id")
  assetRequests AssetRequest[] @relation("asset_request_tenant_id")
  approvals Approval[] @relation("approval_tenant_id")
  countCampaigns CountCampaign[] @relation("count_campaign_tenant_id")
  countTasks CountTask[] @relation("count_task_tenant_id")
  countItems CountItem[] @relation("count_item_tenant_id")
  countScans CountScan[] @relation("count_scan_tenant_id")
  countUnregistereds CountUnregistered[] @relation("count_unregistered_tenant_id")
  pdaDevices PdaDevice[] @relation("pda_device_tenant_id")
  labelTemplates LabelTemplate[] @relation("label_template_tenant_id")
  printers Printer[] @relation("printer_tenant_id")
  labelPrintJobs LabelPrintJob[] @relation("label_print_job_tenant_id")
  sapPostings SapPosting[] @relation("sap_posting_tenant_id")
  sapIfRuns SapIfRun[] @relation("sap_if_run_tenant_id")
