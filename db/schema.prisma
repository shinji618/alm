  countUnregisteredsResolved CountUnregistered[] @relation("count_unregistered_resolved_by")
  pdaDevices PdaDevice[] @relation("pda_device_last_user_id")
  labelPrintJobs LabelPrintJob[] @relation("label_print_job_requested_by")
  sapPostings SapPosting[] @relation("sap_posting_approved_by")
  reconDiffs ReconDiff[] @relation("recon_diff_resolved_by")
