  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node", "lib": ["ES2022"],
    "strict": true, "noUnusedLocals": true, "noImplicitReturns": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "types": ["node"], "sourceMap": true
  }
