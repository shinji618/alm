{
  "name": "@alm/api",
  "private": true,
  "version": "0.1.0",
  "description": "ALM API·worker·운영 작업 (WBS 3.4). 이미지 1개, 역할은 node dist/main <role>",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-reporter=spec \"dist-test/test/*.test.js\"",
    "start": "node dist/main api"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-lambda": "3.1149.0",
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-sesv2": "3.1149.0",
    "@aws-sdk/client-sqs": "3.1149.0",
    "@aws-sdk/credential-provider-node": "3.972.85",
    "@aws-sdk/rds-signer": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@smithy/signature-v4": "5.7.4",
    "aws-jwt-verify": "5.2.1",
    "cookie-parser": "1.4.7",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
