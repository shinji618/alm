{
  "name": "@alm/infra",
  "private": true,
  "version": "0.1.0",
  "description": "ALM AWS infrastructure (CDK, WBS 3.1)",
  "bin": {
    "alm-infra": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth -c env=dev -q && cdk synth -c env=qa -q && cdk synth -c env=prd -q && cdk synth -c env=global -q",
    "synth:dev": "cdk synth -c env=dev",
    "diff:dev": "cdk diff -c env=dev",
    "check": "npm run build && npm test && npm run synth"
  },
  "dependencies": {
    "aws-cdk-lib": "2.273.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "aws-cdk": "2.1145.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
